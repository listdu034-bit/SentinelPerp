# Default uses same-origin proxies; never put secrets in VITE_* values.
API_PROXY_TARGET=http://127.0.0.1:8000
# VITE_API_BASE_URL=https://api.example.com/api/v1
# VITE_WS_BASE_URL=wss://api.example.com
# M2 uses /api separately from M1 /api/v1. Mock mode is explicit and off by default.
# VITE_M2_API_BASE_URL=https://api.example.com/api
VITE_M2_MOCK=false
