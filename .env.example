# Copy to .env and replace the placeholder password in BOTH entries.
POSTGRES_DB=sentinelperp
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://sentinel:replace-me@timescaledb:5432/sentinelperp
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
OKX_MARKET_FILTER=*-USDT-SWAP
OKX_REST_URL=https://www.okx.com
INSTRUMENT_REFRESH_SECONDS=300
REDIS_MAX_CONNECTIONS=50
REDIS_LATEST_TTL=3600
REDIS_QUALITY_TTL=86400
DB_POOL_MIN_SIZE=2
DB_POOL_SIZE=20
DB_COMMAND_TIMEOUT=30
BATCH_SIZE=100
BATCH_FLUSH_SECONDS=1
BUFFER_MAX_SIZE=10000
WRITE_RETRY_ATTEMPTS=5
RETRY_MAX_SECONDS=10
DEDUP_MODE=dual
DEDUP_BUCKET_SECONDS=3600
DEDUP_TTL_SECONDS=86400
TRADE_MAX_LATENCY_MS=5000
OUT_OF_ORDER_TOLERANCE_MS=2000
TRADE_STALE_SECONDS=15
QUALITY_CHECK_SECONDS=5
TRADE_ID_GAP_DETECTION=true
ORDERBOOK_DEPTH=20
ORDERBOOK_SNAPSHOT_SECONDS=60
FEED_TIMEOUT_SECONDS=30
FEED_RECONNECT_SECONDS=5

# JSON list; include the actual console origin in production.
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]

# M2: apply scripts/migrate_m2.sql before enabling scheduled jobs.
M2_SCHEDULER_ENABLED=true
FEATURE_CONCURRENCY=4
ANALYSIS_CONCURRENCY=2
ANALYSIS_QUEUE_SIZE=100
AI_TIMEOUT_SECONDS=120
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPPORTUNITY_MIN_QUALITY=0.7
OPPORTUNITY_MIN_SIMILARITY=0.8
